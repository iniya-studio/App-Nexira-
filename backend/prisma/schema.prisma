generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum PrincipalType {
  USER
  GUEST
}

enum GuestIdentityStatus {
  ACTIVE
  CONVERTED
  REVOKED
}

enum IdentityProvider {
  GOOGLE
  APPLE
}

enum IdentityAuditResult {
  SUCCESS
  FAILURE
}

enum MatchMode {
  ONE_V_ONE
  ONE_V_AI
  ROOM
}

enum MatchStatus {
  WAITING
  READY
  ACTIVE
  COMPLETED
  CANCELLED
}

enum QuickBattleStatus {
  PREPARING
  READY
  ACTIVE
  COMPLETED
  VOIDED
  CANCELLED
}

enum QuickBattleGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum MatchmakingEntryStatus {
  WAITING
  MATCHED
  CANCELLED
  EXPIRED
}

enum QuestionGenerationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AiAnswerJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ParticipantType {
  HUMAN
  AI
}

enum ParticipantStatus {
  ACTIVE
  COMPLETED
  DISCONNECTED
  FORFEITED
}

enum AnswerStatus {
  ANSWERED
  NO_RESPONSE
}

enum JudgeDecision {
  CORRECT
  INCORRECT
  UNCERTAIN
}

enum JudgeStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MatchScoreEntryType {
  ANSWER_SCORE
  NO_RESPONSE_PENALTY
  FORFEIT_TRANSFER
  ROUND_VOID_REVERSAL
}

enum RoomType {
  PRIVATE
  PUBLIC
}

enum RoomMatchStrategy {
  SYNCHRONIZED
  HOST_CONTROLLED
}

enum RoomStatus {
  OPEN
  COUNTDOWN
  IN_MATCH
  CLOSED
}

enum RoomMemberStatus {
  PENDING
  ACTIVE
  LEFT
  REMOVED
}

enum RankingSeasonStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum RankingScope {
  GLOBAL
  SEASON
}

enum StoreItemType {
  AVATAR
  AVATAR_FRAME
  PROFILE_THEME
  NAMEPLATE
  EMOTE
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

// Account deletion is a controlled soft-delete/anonymization workflow, not routine row deletion.
// Preserve competitive and purchase history; revoke active sessions and restrict account access.
// Personal-data retention and anonymization details are handled by an explicit application policy.
