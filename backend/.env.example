# Copy to .env locally. Never commit real credentials.
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexira?schema=public

# Generate independent secrets with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_BASE64_32_BYTE_SECRET
REFRESH_RETRY_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_BASE64_32_BYTE_SECRET
JWT_ISSUER=https://api.nexira.example
JWT_AUDIENCE=nexira-api

# All lifetimes are configurable. Session and refresh lifetimes must be selected
# by the owner before release; the application intentionally has no implicit values.
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_ABSOLUTE_TTL_SECONDS=
REFRESH_TOKEN_TTL_SECONDS=
REFRESH_RETRY_WINDOW_SECONDS=60

# Initial single-instance guest-start abuse guard; configure edge limits as well.
GUEST_START_MAX_ATTEMPTS=10
GUEST_START_WINDOW_SECONDS=60
