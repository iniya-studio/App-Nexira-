# Copy to .env locally. Never commit real credentials.
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexira?schema=public

# Generate independent secrets with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_BASE64_32_BYTE_SECRET
REFRESH_RETRY_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_BASE64_32_BYTE_SECRET
JWT_ISSUER=https://api.nexira.example
JWT_AUDIENCE=nexira-api

# Google OAuth Web client ID. Never accept a client-supplied audience.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID

# Argon2id parameters; benchmark on the production deployment target.
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# All lifetimes are configurable. Session and refresh lifetimes must be selected
# by the owner before release; the application intentionally has no implicit values.
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_ABSOLUTE_TTL_SECONDS=
REFRESH_TOKEN_TTL_SECONDS=
REFRESH_RETRY_WINDOW_SECONDS=60

# Initial single-instance abuse guards; configure distributed edge limits as well.
GUEST_START_MAX_ATTEMPTS=10
GUEST_START_WINDOW_SECONDS=60
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REGISTER_MAX_ATTEMPTS=5
AUTH_REGISTER_WINDOW_SECONDS=3600

# Independent AI opponent response provider; never expose these credentials to clients.
AI_OPPONENT_API_KEY=
AI_OPPONENT_MODEL=
AI_OPPONENT_BASE_URL=https://api.openai.com/v1
AI_OPPONENT_TIMEOUT_MS=6000

# Provider-independent AI Judge; the model is selected per deployment.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_JUDGE_TIMEOUT_MS=8000

# Independent provider credentials for AI Question Generation.
QUESTION_GENERATOR_OPENAI_API_KEY=
QUESTION_GENERATOR_OPENAI_MODEL=
QUESTION_GENERATOR_OPENAI_BASE_URL=https://api.openai.com/v1
QUESTION_GENERATOR_TIMEOUT_MS=12000

# Provider-independent SMTP email delivery; never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Absolute frontend page URL that reads ?token=... and calls the verification API.
EMAIL_VERIFICATION_URL=
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
EMAIL_VERIFICATION_RESEND_MAX_ATTEMPTS=3
EMAIL_VERIFICATION_RESEND_WINDOW_SECONDS=3600
