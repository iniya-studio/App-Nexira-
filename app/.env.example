# Copy to app/.env.local for local builds. Never commit real credentials.
# Native Credential Manager sends Google ID tokens to the NEXIRA backend.
# Use the Web OAuth client ID here and as backend GOOGLE_CLIENT_ID; also configure an Android OAuth client with the app package + signing SHA-1.
# Create both Android (package + signing SHA-1) and Web OAuth clients in one Google Cloud project.
VITE_API_BASE_URL=
VITE_GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
