NEXIRA_DOMAIN=api-staging.example.com
ACME_EMAIL=ops@example.com
# Generate with openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
# Generate each independently with openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_INDEPENDENT_BASE64_32_BYTE_SECRET
REFRESH_RETRY_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_BASE64_32_BYTE_SECRET
# Independent key for encrypted guest-conversion response recovery.
GUEST_CONVERSION_REPLAY_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_INDEPENDENT_BASE64_32_BYTE_SECRET
GUEST_CONVERSION_REPLAY_WINDOW_SECONDS=300
GUEST_CONVERSION_MAX_ATTEMPTS=5
GUEST_CONVERSION_WINDOW_SECONDS=3600
GUEST_CONVERSION_IP_MAX_ATTEMPTS=30
GUEST_CONVERSION_RETRY_MAX_ATTEMPTS=10
GUEST_CONVERSION_RETRY_IP_MAX_ATTEMPTS=60
JWT_ISSUER=https://api-staging.example.com
JWT_AUDIENCE=nexira-api
SESSION_ABSOLUTE_TTL_SECONDS=2592000
REFRESH_TOKEN_TTL_SECONDS=2592000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_RETRY_WINDOW_SECONDS=60
TRUST_PROXY_HOPS=1
API_PREFIX=api/v1
CORS_ORIGINS=https://localhost,capacitor://localhost
GOOGLE_CLIENT_ID=
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
GUEST_START_MAX_ATTEMPTS=10
GUEST_START_WINDOW_SECONDS=60
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REGISTER_MAX_ATTEMPTS=5
AUTH_REGISTER_WINDOW_SECONDS=3600
AI_OPPONENT_API_KEY=
AI_OPPONENT_MODEL=
AI_OPPONENT_BASE_URL=https://api.openai.com/v1
AI_OPPONENT_TIMEOUT_MS=6000
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_JUDGE_TIMEOUT_MS=8000
QUESTION_GENERATOR_OPENAI_API_KEY=
QUESTION_GENERATOR_OPENAI_MODEL=
QUESTION_GENERATOR_OPENAI_BASE_URL=https://api.openai.com/v1
QUESTION_GENERATOR_TIMEOUT_MS=12000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
